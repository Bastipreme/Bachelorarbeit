# Vorlage fuer .env (nur fuer den Start ueber Docker Compose noetig)
#
# Diese Datei nach .env kopieren und den Platzhalter ersetzen:
#
#   cp .env.example .env
#   docker compose up --build
#
# docker-compose.yml reicht die Variable als OPENAI_API_KEY an den
# Container weiter. .env ist in .gitignore ausgeschlossen.

OPENAI_API_KEY=sk-DEIN-SCHLUESSEL-HIER
