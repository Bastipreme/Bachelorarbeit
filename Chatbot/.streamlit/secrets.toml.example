# Vorlage fuer .streamlit/secrets.toml
#
# Diese Datei nach secrets.toml kopieren und den Platzhalter durch einen
# eigenen OpenAI-API-Schluessel ersetzen:
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#
# secrets.toml selbst ist in .gitignore ausgeschlossen und darf nicht
# eingecheckt werden. Der Schluessel wird in Chatbot.py ueber
# st.secrets["OPENAI_API_KEY"] gelesen.
#
# Einen Schluessel gibt es unter https://platform.openai.com/api-keys

OPENAI_API_KEY = "sk-DEIN-SCHLUESSEL-HIER"
