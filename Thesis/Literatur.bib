@article{labadzeRoleAIChatbots2023,
  title = {Role of {{AI}} Chatbots in Education: Systematic Literature Review},
  shorttitle = {Role of {{AI}} Chatbots in Education},
  author = {Labadze, Lasha and Grigolia, Maya and Machaidze, Lela},
  date = {2023-10-31},
  journaltitle = {International Journal of Educational Technology in Higher Education},
  shortjournal = {Int J Educ Technol High Educ},
